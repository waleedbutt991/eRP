{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" },
    { "src": "dashboard.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/dashboard.html" },
    { "src": "/(.+)", "dest": "/frontend/$1" }
  ]
}